# --- required ---------------------------------------------------------
TAVILY_API_KEY=tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- models -----------------------------------------------------------
# FAST: high-volume mechanical work (query generation, extraction, routing)
# SMART: judgment (planning, gap analysis, synthesis). Defaults to FAST.
# Pointing SMART at a larger model is the biggest quality lever after retrieval.
FAST_MODEL=qwen3:8b
# SMART_MODEL=qwen3:32b
EMBED_MODEL=nomic-embed-text
TEMPERATURE=0.1
NUM_CTX=8192

# --- research budgets -------------------------------------------------
MIN_SUB_QUESTIONS=3
MAX_SUB_QUESTIONS=6
MAX_ROUNDS=3
MAX_SEARCHES=24
MAX_SOURCES=40
QUERIES_PER_SUB_QUESTION=2
RESULTS_PER_QUERY=4
SOURCE_CHARS=6000

# --- safety -----------------------------------------------------------
REACT_MAX_ITERS=10
